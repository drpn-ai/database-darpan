<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <entity entity-name="DatabaseSourceConfig" package="darpan.database" short-alias="databaseSourceConfig" use="configuration">
        <description>Customer database connection for reconciliation extraction. The JDBC URL is always
            built server-side (JdbcUrlSupport) from these structured fields; no raw URL is stored.</description>
        <field name="databaseSourceConfigId" type="id" is-pk="true"/>
        <field name="companyUserGroupId" type="id"/>
        <field name="description" type="text-medium"/>
        <field name="dialect" type="text-short" default="'MYSQL'">
            <description>MYSQL, POSTGRES, or DB2 (JdbcUrlSupport rejects anything else).</description>
        </field>
        <field name="host" type="text-medium" cannot-be-null="true"/>
        <field name="port" type="number-integer">
            <description>Optional; JdbcUrlSupport applies the dialect default (3306 / 5432 / 50000).</description>
        </field>
        <field name="databaseName" type="text-medium" cannot-be-null="true"/>
        <field name="username" type="text-medium" cannot-be-null="true"/>
        <field name="password" type="text-medium" encrypt="true"/>
        <field name="requireTls" type="text-indicator" default="'Y'"/>
        <field name="caCertPem" type="text-very-long">
            <description>Optional CA certificate (PEM) for sslMode=VERIFY_CA.</description>
        </field>
        <field name="connectTimeoutSeconds" type="number-integer" default="10"/>
        <field name="queryTimeoutSeconds" type="number-integer" default="300"/>
        <field name="maxRows" type="number-integer" default="500000">
            <description>Hard cap; exceeding it fails the extraction (never truncates).</description>
        </field>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <field name="createdDate" type="date-time"/>
        <field name="lastUpdatedDate" type="date-time"/>
        <relationship type="one" title="Company" related="moqui.security.UserGroup" fk-name="DBSRCCONF_COMPANY">
            <key-map field-name="companyUserGroupId" related-field-name="userGroupId"/>
        </relationship>
    </entity>

    <entity entity-name="DatabaseSourceQuery" package="darpan.database" short-alias="databaseSourceQuery" use="configuration">
        <description>One extractable dataset: a validated parameterized SELECT against a DatabaseSourceConfig.</description>
        <field name="databaseSourceQueryId" type="id" is-pk="true"/>
        <field name="databaseSourceConfigId" type="id" cannot-be-null="true"/>
        <field name="companyUserGroupId" type="id"/>
        <field name="description" type="text-medium"/>
        <field name="sqlSelect" type="text-very-long" cannot-be-null="true">
            <description>Single SELECT (or WITH...SELECT). Optional named placeholders :windowStart and :windowEnd.</description>
        </field>
        <field name="isActive" type="text-indicator" default="'Y'"/>
        <field name="createdDate" type="date-time"/>
        <field name="lastUpdatedDate" type="date-time"/>
        <relationship type="one" related="darpan.database.DatabaseSourceConfig" fk-name="DBSRCQRY_CONF">
            <key-map field-name="databaseSourceConfigId"/>
        </relationship>
        <relationship type="one" title="Company" related="moqui.security.UserGroup" fk-name="DBSRCQRY_COMPANY">
            <key-map field-name="companyUserGroupId" related-field-name="userGroupId"/>
        </relationship>
    </entity>
</entities>
