<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="validate" noun="DatabaseConnection" type="script" transaction="ignore" authenticate="true"
            location="component://database-darpan/src/main/groovy/darpan/database/facade/validateDatabaseConnection.groovy">
        <description>Connects and runs the dialect test query. Accepts a saved config id or transient fields (pre-save test).</description>
        <in-parameters>
            <parameter name="databaseSourceConfigId"/>
            <parameter name="host"/><parameter name="port" type="Long"/>
            <parameter name="databaseName"/><parameter name="username"/><parameter name="password"/>
            <parameter name="dialect"/>
            <parameter name="requireTls"/><parameter name="connectTimeoutSeconds" type="Long"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="serverVersion"/>
            <parameter name="error"/>
        </out-parameters>
    </service>
    <service verb="preview" noun="DatabaseQuery" type="script" transaction="ignore" allow-remote="true" authenticate="true"
            location="component://database-darpan/src/main/groovy/darpan/database/facade/previewDatabaseQuery.groovy">
        <description>Validates and runs a SELECT capped at 10 rows for the query editor preview.</description>
        <in-parameters>
            <parameter name="databaseSourceQueryId"/>
            <parameter name="databaseSourceConfigId"/>
            <!-- allow-html="any": a SELECT legitimately contains < and >= . Moqui's HTML filter is an
                 XSS guard for rendered output and has no bearing here; SqlSelectValidator plus the
                 read-only fence are what actually constrain this field. -->
            <parameter name="sqlSelect" allow-html="any"/>
            <parameter name="windowStart" type="Timestamp"/><parameter name="windowEnd" type="Timestamp"/>
        </in-parameters>
        <out-parameters>
            <parameter name="columns" type="List"/>
            <parameter name="rows" type="List"/>
            <parameter name="error"/>
        </out-parameters>
    </service>

    <service verb="probe" noun="DatabaseConnection" type="script" transaction="ignore"
             allow-remote="false" authenticate="true"
             location="component://database-darpan/src/main/groovy/darpan/database/facade/probeDatabaseConnection.groovy">
        <description>Connection diagnostics for a saved database source config. Registered on the
            SourceSystemConnector DATABASE row as healthCheckServiceName and invoked only through
            facade.SettingsFacadeServices.test#SourceConnection, which owns the permission gate.
            Read-only, one connection, no retries. Never writes to ec.message: a rejected credential
            is a check row, not a service error.</description>
        <in-parameters>
            <parameter name="databaseSourceConfigId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="checks" type="List"><parameter name="check" type="Map"/></parameter>
        </out-parameters>
    </service>

    <service verb="save" noun="DatabaseSourceConfig" type="script" allow-remote="true" authenticate="true"
             location="component://database-darpan/src/main/groovy/darpan/database/facade/saveDatabaseSourceConfig.groovy">
        <description>Create or update a database connection config for the active tenant. Tenant-admin only:
            the facade artifact group is a pattern group, so the role gate must live in the script.</description>
        <in-parameters>
            <parameter name="databaseSourceConfigId"/>
            <parameter name="description"/>
            <parameter name="dialect" default-value="MYSQL"/>
            <parameter name="host" required="true"/>
            <parameter name="port" type="Integer"/>
            <parameter name="databaseName" required="true"/>
            <parameter name="username" required="true"/>
            <parameter name="password"/>
            <parameter name="requireTls" default-value="Y"/>
            <parameter name="caCertPem"/>
            <parameter name="connectTimeoutSeconds" type="Integer" default-value="10"/>
            <parameter name="queryTimeoutSeconds" type="Integer" default-value="300"/>
            <parameter name="maxRows" type="Integer" default-value="500000"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="databaseSourceConfigId"/>
        </out-parameters>
    </service>

    <service verb="list" noun="DatabaseSourceConfigs" allow-remote="true" authenticate="true">
        <description>Database connection configs visible in the active tenant. Credentials are never returned.</description>
        <out-parameters>
            <parameter name="configs" type="List"><parameter name="config" type="Map"/></parameter>
        </out-parameters>
        <actions>
            <!-- Tenant scope is the explicit condition below, so it holds whatever the caller's authz posture;
                 on an authz-enabled facade call the DARPAN_ACTIVE_COMPANY_SCOPE filter applies the same scope
                 again (DAR-BE-076). Not a primary-key lookup, so the condition is never dropped. -->
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <set field="configs" from="[]"/>
            <if condition="tenantId">
                <entity-find entity-name="darpan.database.DatabaseSourceConfig" list="configRows" cache="false">
                    <econdition field-name="companyUserGroupId" from="tenantId"/>
                </entity-find>
                <!-- Explicit allowlist rather than the whole row: the credential must never leave the server,
                     and an allowlist stays correct when new columns are added to the entity. -->
                <set field="configs" from="configRows.collect { row -> [databaseSourceConfigId: row.databaseSourceConfigId, description: row.description,
                        dialect: row.dialect, host: row.host, port: row.port, databaseName: row.databaseName, username: row.username,
                        requireTls: row.requireTls, isActive: row.isActive] }"/>
            </if>
        </actions>
    </service>

    <service verb="delete" noun="DatabaseSourceConfig" allow-remote="true" authenticate="true">
        <description>Delete a database connection config. Tenant-admin only. Refuses while queries reference it.</description>
        <in-parameters><parameter name="databaseSourceConfigId" required="true"/></in-parameters>
        <out-parameters><parameter name="ok" type="Boolean"/></out-parameters>
        <actions>
            <set field="ok" from="false"/>
            <if condition="!darpan.facade.common.TenantAccessSupport.canEditActiveTenantData(ec)">
                <message error="true">You do not have permission to change database sources in this tenant.</message>
                <return/>
            </if>
            <!-- Read past the tenant filter on purpose, then gate in code: a foreign row must get the
                 "not available in your active tenant" answer, not a filtered-away "not found". -->
            <set field="existing" from="darpan.facade.common.TenantScopedFinder.findGlobalUnscoped(ec, 'darpan.database.DatabaseSourceConfig', 'delete#DatabaseSourceConfig existence check; requireTenantRecordAccess gates it on the next line').condition('databaseSourceConfigId', databaseSourceConfigId).useCache(false).one()"/>
            <set field="ignoreAccess" from="darpan.facade.common.TenantAccessSupport.requireTenantRecordAccess(ec, existing, &quot;Database source config ${databaseSourceConfigId} not found.&quot;, &quot;Database source config ${databaseSourceConfigId} is not available in your active tenant.&quot;)"/>
            <if condition="ec.message.hasError()"><return/></if>
            <!-- Every referencing query counts, whatever its stamp: deleting the connection orphans them all. -->
            <set field="referencing" from="darpan.facade.common.TenantScopedFinder.findGlobalUnscoped(ec, 'darpan.database.DatabaseSourceQuery', 'delete#DatabaseSourceConfig orphan guard counts every query on a config the caller was just gated for').condition('databaseSourceConfigId', databaseSourceConfigId).count()"/>
            <if condition="referencing &gt; 0">
                <message error="true">Cannot delete: ${referencing} saved quer${referencing == 1 ? 'y' : 'ies'} still use this connection.</message>
                <return/>
            </if>
            <service-call name="delete#darpan.database.DatabaseSourceConfig" in-map="[databaseSourceConfigId: databaseSourceConfigId]"/>
            <set field="ok" from="!ec.message.hasError()"/>
        </actions>
    </service>

    <service verb="save" noun="DatabaseSourceQuery" type="script" allow-remote="true" authenticate="true"
             location="component://database-darpan/src/main/groovy/darpan/database/facade/saveDatabaseSourceQuery.groovy">
        <description>Create or update a SELECT for a database source config. Tenant-admin only.
            The statement is validated before it is persisted, so an unvalidated statement can never
            reach the extractor.</description>
        <in-parameters>
            <parameter name="databaseSourceQueryId"/>
            <parameter name="databaseSourceConfigId" required="true"/>
            <parameter name="description"/>
            <!-- allow-html="any": see preview#DatabaseQuery. Without it, the canonical windowed
                 query (entry_date >= :windowStart AND entry_date < :windowEnd) cannot be saved. -->
            <parameter name="sqlSelect" required="true" allow-html="any"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="databaseSourceQueryId"/>
        </out-parameters>
    </service>

    <service verb="list" noun="DatabaseSourceQueries" allow-remote="true" authenticate="true">
        <description>Saved queries in the active tenant, optionally filtered to one config.</description>
        <in-parameters><parameter name="databaseSourceConfigId"/></in-parameters>
        <out-parameters>
            <parameter name="queries" type="List"><parameter name="query" type="Map"/></parameter>
        </out-parameters>
        <actions>
            <!-- See list#DatabaseSourceConfigs: explicit tenant condition, plus the entity filter on a facade call. -->
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <set field="queries" from="[]"/>
            <if condition="tenantId">
                <entity-find entity-name="darpan.database.DatabaseSourceQuery" list="queryRows" cache="false">
                    <econdition field-name="companyUserGroupId" from="tenantId"/>
                    <econdition field-name="databaseSourceConfigId" ignore-if-empty="true"/>
                </entity-find>
                <set field="queries" from="queryRows.collect { row -> [databaseSourceQueryId: row.databaseSourceQueryId,
                        databaseSourceConfigId: row.databaseSourceConfigId, description: row.description,
                        sqlSelect: row.sqlSelect, isActive: row.isActive] }"/>
            </if>
        </actions>
    </service>

    <service verb="delete" noun="DatabaseSourceQuery" allow-remote="true" authenticate="true">
        <description>Delete a saved query. Tenant-admin only.</description>
        <in-parameters><parameter name="databaseSourceQueryId" required="true"/></in-parameters>
        <out-parameters><parameter name="ok" type="Boolean"/></out-parameters>
        <actions>
            <set field="ok" from="false"/>
            <if condition="!darpan.facade.common.TenantAccessSupport.canEditActiveTenantData(ec)">
                <message error="true">You do not have permission to change database sources in this tenant.</message>
                <return/>
            </if>
            <!-- See delete#DatabaseSourceConfig: read past the filter, then gate in code. -->
            <set field="existing" from="darpan.facade.common.TenantScopedFinder.findGlobalUnscoped(ec, 'darpan.database.DatabaseSourceQuery', 'delete#DatabaseSourceQuery existence check; requireTenantRecordAccess gates it on the next line').condition('databaseSourceQueryId', databaseSourceQueryId).useCache(false).one()"/>
            <set field="ignoreAccess" from="darpan.facade.common.TenantAccessSupport.requireTenantRecordAccess(ec, existing, &quot;Database source query ${databaseSourceQueryId} not found.&quot;, &quot;Database source query ${databaseSourceQueryId} is not available in your active tenant.&quot;)"/>
            <if condition="ec.message.hasError()"><return/></if>
            <service-call name="delete#darpan.database.DatabaseSourceQuery" in-map="[databaseSourceQueryId: databaseSourceQueryId]"/>
            <set field="ok" from="!ec.message.hasError()"/>
        </actions>
    </service>
</services>
